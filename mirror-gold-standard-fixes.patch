+nestedBlockquoteJson :: Int -> Text.Text
+nestedBlockquoteJson 0 = "{\"type\":\"paragraph\",\"content\":[]}"
+nestedBlockquoteJson n = "{\"type\":\"blockquote\",\"content\":[" <> nestedBlockquoteJson (n - 1) <> "]}"
