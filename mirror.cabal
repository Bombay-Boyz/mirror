cabal-version:      2.4
name:               mirror
version:            1.0.0.0
build-type:         Simple

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wmissing-export-lists
    -Wunused-imports
    -Wredundant-constraints
    -Wpartial-fields
    -Widentities
    -Werror

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Mirror.Error
    Mirror.Document
    Mirror.Document.Raw
    Mirror.Html
    Mirror.Css
    Mirror.Parser.Markdown
    Mirror.Parser.Markdown.Inline
    Mirror.Parser.Docx
    Mirror.Parser.Json
    Mirror.Renderer.Html
    Mirror.Pipeline
  build-depends:
    base >=4.14 && <5,
    text >=1.2 && <2.1,
    bytestring >=0.10 && <0.12,
    containers >=0.6 && <0.7,
    vector >=0.12 && <0.14,
    aeson >=2.0 && <2.3,
    megaparsec >=9.0 && <10,
    base64-bytestring >=1.0 && <1.3,
    zip-archive >=0.4 && <0.5,
    xml-conduit >=1.9 && <1.11,
    modern-uri >=0.3 && <0.4,
    optparse-applicative >=0.17 && <0.20,
    filepath >=1.4 && <1.5,
    transformers >=0.5 && <0.7,
    file-embed >=0.0.15 && <0.1
  default-extensions:
    OverloadedStrings, LambdaCase, DerivingStrategies
  default-language: Haskell2010

executable mirror
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.14 && <5,
    mirror,
    optparse-applicative >=0.17 && <0.20,
    text >=1.2 && <2.1
  default-extensions:
    OverloadedStrings, LambdaCase, DerivingStrategies
  default-language: Haskell2010

test-suite mirror-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    base >=4.14 && <5,
    mirror,
    hspec >=2.7 && <3,
    QuickCheck >=2.14 && <2.19,
    text >=1.2 && <2.1,
    bytestring >=0.10 && <0.12,
    transformers >=0.5 && <0.7,
    zip-archive >=0.4 && <0.5
  default-extensions:
    OverloadedStrings, LambdaCase, DerivingStrategies
  default-language: Haskell2010
